// CI config: resolve all path params against the project dir so the same
// params files work no matter where the pipeline is launched from.
params.reference_genome = "${projectDir}/assets/tests/fixture/cba/reference.fa"
params.query_genome     = "${projectDir}/assets/tests/fixture/cba/query.fa"
params.filled_chain_path = "${projectDir}/assets/tests/fixture/cba/filled.chain"
params.outdir           = "${projectDir}/assets/tests/work/cba_results"

// skip pipeline_info reporting (would write to <repo>/results regardless of outdir)
report { enabled = false }
timeline { enabled = false }
trace { enabled = false }
dag { enabled = false }
