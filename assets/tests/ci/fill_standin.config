// compare_fill.sh only: run HSPZ_FILL in the pipeline image with the CPU
// stand-in mounted as hspZ (assets/tests/ci/hspz_paired_standin.sh), so the hspz
// fill engine can be checked against REPEAT_FILLER without a GPU.
process {
    withName: '.*:HSPZ_FILL' {
        container        = 'ghcr.io/hillerlab/make_lastz_chains:latest'
        // a closure: workflow.containerEngine is only known when the task runs
        containerOptions = { (workflow.containerEngine in ['apptainer', 'singularity'] ? '-B ' : '-v ') +
                             "${projectDir}/assets/tests/ci/hspz_paired_standin.sh:/usr/local/bin/hspZ:ro" }
    }
}
