/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    make_lastz_chains — single unified Nextflow configuration

    Infrastructure configuration — do not edit for normal runs.
    Scientific parameters (genome paths, alignment settings) live in params.json.

    Usage:
      nextflow run main.nf -params-file params.json -profile apptainer,slurm

    This file contains:
      1. params {}          — output dir, resource ceilings, nf-core boilerplate
      2. Process resources  — compute tiers (cpus, memory, time) via withLabel
      3. Per-step config    — container, conda, publishDir via withName
      4. Profiles           — executor and environment selection
      5. Reporting          — timeline, trace, DAG
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

nextflow.enable.dsl = 2

cleanup = false
workDir = 'work'

manifest {
    name            = 'make_lastz_chains'
    author          = 'Alejandro Gonzales-Irribarren, Nil Tianchen Mu, Bogdan M. Kirilenko, Michael Hiller'
    homePage        = 'https://github.com/hillerlab/make_lastz_chains'
    description     = 'Pipeline to create chain-formatted pairwise genome alignments.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.6'
    version         = '4.0.0'
}

validation {
    help {
        enabled = true
        command = "nextflow run main.nf -profile <docker/singularity/.../institute>"
        fullParameter = "help_full"
        showHiddenParameter = "show_hidden"
    }
}

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 1 — Infrastructure parameters
// Edit this section only to change compute limits or output behaviour.
// Scientific parameters live in params.json.
// ══════════════════════════════════════════════════════════════════════════════

params {
    // ── Checkpoint ──────────────────────────────────────────────────────────────
    from = null

    // ── Output ──────────────────────────────────────────────────────────────
    outdir           = './results'
    publish_dir_mode = 'copy'

    // ── Alignment backend ───────────────────────────────────────────────────
    // 'lastz' (CPU, default) or 'kegalign' (GPU — needs -profile gpu).
    aligner          = 'lastz'
    // How the KegAlign backend runs its CPU gapped-extension stage:
    //   'batched'     one task, KegAlign's own process pool (default)
    //   'distributed' one Nextflow task per KegAlign partition
    // Stays 'batched' until benchmarks justify the switch.
    kegalign_executor = 'batched'
    // Concurrent KegAlign instances sharing the one allocated GPU through the
    // NVIDIA MPS daemon. 1 = no MPS (unchanged single-instance execution).
    // > 1 splits both genomes into chromosome bins and aligns bin pairs
    // concurrently; each instance can want 12-16 GiB VRAM, so raise it only as
    // far as the physical GPU allows (80 GB → 4 is worth testing, 32-40 GB → 2).
    kegalign_mps_workers = 1

    // ── Debug ───────────────────────────────────────────────────────────────
    // Force faToTwoBit -long (always v1 .2bit). Used to exercise the v1 path
    // on small genomes for parity testing — leave false in production.
    force_long_2bit  = false

    // Ceilings the `zluda` local-development profile clamps every task to,
    // because the cluster-sized requests do not fit one workstation.
    zluda_cpus       = 16
    zluda_memory     = 60.GB
    // Both set by their profile of the same name; SECTION 5b keys off them
    // because `workflow` is not bound yet while this file is being parsed.
    zluda            = false
    zluda_mps_stub   = false

    // ── nf-core boilerplate ──────────────────────────────────────────────────
    use_container    = true
    validate_params  = true
    help             = false
    version          = false
    monochrome_logs  = false
    email            = null
    email_on_fail    = null

    // ── Chain cleaning ───────────────────────────────────────────────────────
    clean_chain_parameters = '--lr-fold-threshold 2.5 --do-pairs --lr-fold-threshold-pairs 10 --max-pair-distance 10000 --max-suspect-score 100000 --min-broken-chain-score 75000'
}

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 2 — Compute resource tiers  (withLabel)
//
// All pipeline tools are single-threaded, so cpus is fixed at 1.
// Memory and time scale with task.attempt.
//
// SLURM partition routing (slurm profile):
//   All current labels (0.5 h – 3 h) → htc partition (public QOS)
//   Jobs > 4 h → public partition (public QOS)
// ══════════════════════════════════════════════════════════════════════════════

process {
    shell    = ['/bin/bash', '-euo', 'pipefail']

    // Conda is disabled by default — use -profile apptainer (or conda to re-enable)
    conda.enabled = false

    // Retry up to maxRetries times, then terminate the workflow. Using a
    // dynamic errorStrategy (rather than maxErrors = 1) so a permanent task
    // failure ALWAYS aborts — `maxErrors = -1` previously masked silent data
    // loss (e.g. the BULK filename-too-long bug).
    errorStrategy = {
        (task.exitStatus in ((130..145) + 104 + 175)) ||
        (task.exitStatus in [null, Integer.MAX_VALUE])   ? 'retry' : 'finish'
    }
    maxRetries    = 8

    // Short-lived steps + LASTZ chunks (conversion, partition, LASTZ, cat, bundle, filter)
    withLabel: 'process_fast' {
        cpus   = 1
        memory = { 24.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    // Low steps: chaintools-related + psltools-related
    withLabel: 'process_low' {
        cpus   = 4
        memory = { 24.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    // Medium steps: PSL sorting, axtChain, fill chain merge
    withLabel: 'process_medium' {
        cpus   = 8
        memory = { 50.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    // GPU
    withLabel: process_gpu {
        ext.use_gpu = { workflow.profile.contains('gpu') }
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
        time = { 16.h * task.attempt }
        memory = { 32.GB * task.attempt }
    }

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 3 — Per-step configuration  (withName)
// Each block sets resources (if not using a label), container image, conda env,
// and whether outputs are published to results/.
// ══════════════════════════════════════════════════════════════════════════════

    // ── STEP 0: Genome preparation ──────────────────────────────────────────

    withName: '.*:FA_TO_TWO_BIT' {
        cpus      = 1
        memory    = { 60.GB * task.attempt }
        time      = { 0.5.h * task.attempt }
        conda     = "${projectDir}/environment.yml"
        
        publishDir = [
            path: { "${params.outdir}/00_genome_prep" },
            mode: params.publish_dir_mode,
            pattern: "*.2bit"
        ]
    }

    withName: '.*:CHROMSIZE' {
        label     = 'process_fast'
        conda     = "${projectDir}/environment.yml"
        
        publishDir = [
            path: { "${params.outdir}/00_genome_prep" },
            mode: params.publish_dir_mode,
            pattern: "*/*chrom.sizes"
        ]
    }

    withName: '.*:EXTRACT_CHROMS' {
        // For v1 .2bit genomes EXTRACT_CHROMS runs `twoBitToFa` once per chrom
        // sequentially (extraction is fast per chrom but accumulates), so it
        // can need more than the 0.5 h `process_fast` ceiling on big genomes.
        cpus      = 1
        memory    = { 24.GB * task.attempt }
        time      = { 2.h   * task.attempt }
        conda     = "${projectDir}/environment.yml"
        // Not published — these per-chrom FASTAs are intermediate and large;
        // they only need to live in the work dir to be symlinked into LASTZ tasks.
    }

    // ── STEP 1: Partition ───────────────────────────────────────────────────

    withName: '.*:PARTITION_REFERENCE|.*:PARTITION_QUERY' {
        label     = 'process_fast'
        conda     = "${projectDir}/environment.yml"
        publishDir = [
            path: { "${params.outdir}/01_partition" },
            mode: params.publish_dir_mode,
            pattern: "*_partitions.txt"
        ]
    }

    // ── STEP 2: LASTZ alignment ─────────────────────────────────────────────

    withName: '.*:LASTZ' {
        label        = 'process_fast'
        beforeScript = 'sleep $((RANDOM % 60))'    // stagger starts to avoid slurm prolog storm
        publishDir   = [
            path: { "${params.outdir}/02_lastz_psl" },
            mode: 'symlink',
            pattern: '*.psl'
        ]
    }

    // ── STEP 4: Chain building (split → bundle → axtChain → merge) ─────────

    withName: '.*:PSLTOOLS_SPLIT' {
        label     = 'process_medium'
        publishDir = [
            path: { "${params.outdir}/03_psl" },
            mode: 'symlink',
            pattern: '*.psl'
        ]
    }

    withName: '.*:PSL_BUNDLE' {
        label     = 'process_fast'
        publishDir = [ enabled: false ]
    }

    withName: '.*:AXT_CHAIN' {
        label     = 'process_medium'
        conda     = "${projectDir}/environment.yml"
        publishDir = [
            path: { "${params.outdir}/04_axtchain" },
            mode: 'symlink',
            pattern: '*.chain'
        ]
    }

    withName: '.*:CHAINTOOLS_ANTIREPEAT' {
        label     = 'process_medium'
        conda     = "${projectDir}/environment.yml"
        cpus      = 16
        publishDir = [
            path: { "${params.outdir}/04_axtchain/chain_antirepeat" },
            mode: 'symlink',
            pattern: '*.chain'
        ]
    }

    withName: '.*:CHAINTOOLS_MERGE' {
        label     = 'process_medium'
        publishDir = [ enabled: false ]
    }

    // ── STEP 5: Fill chains (optional) ─────────────────────────────────────

    withName: '.*:CHAINTOOLS_SPLIT' {
        label     = 'process_fast'
        publishDir = [ enabled: false ]
    }

    withName: '.*:REPEAT_FILLER' {
        cpus      = 1
        memory    = { 24.GB * task.attempt }
        time      = { 6.h   * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: '.*:CHAINTOOLS_MERGE_FILLED_CHAINS' {
        label     = 'process_medium'
        ext.sort_by = 'score'
        publishDir = [
            path: { "${params.outdir}/05_filled_chains" },
            mode: params.publish_dir_mode,
            pattern: "*.chain.gz"
        ]
    }

    // ── STEP 6: Clean chains (optional) ────────────────────────────────────

    withName: '.*:CHAINC' {
        cpus      = 8
        memory    = { 80.GB * task.attempt }
        time      = { 3.h   * task.attempt }
        ext.args  = params.clean_chain_parameters
        publishDir = [
            path: { "${params.outdir}/06_cleaned_chains" },
            mode: 'symlink',
        ]
    }

    withName: '.*:CHAINTOOLS_FILTER_CLEANED_CHAINS' {
        label     = 'process_fast'
        ext.prefix = { "${params.reference_name}.${params.query_name}.allfilled" }
        publishDir = [
            path: { "${params.outdir}/07_final" },
            mode: params.publish_dir_mode,
            pattern: "*chain.gz"
        ]
    }

    withName: '.*:CHAINTOOLS_STATS' {
        label     = 'process_low'
        publishDir = [
            path: { "${params.outdir}/07_final/stats" },
            mode: params.publish_dir_mode,
            pattern: "*.stats.txt"
        ]
    }
}

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 4 — Profiles
// Combine an executor profile with an environment profile, e.g.:
//   -profile apptainer,slurm
// ══════════════════════════════════════════════════════════════════════════════

profiles {

    local {
        process.executor = 'local'
    }

    // ── SLURM (your HPC cluster) ────────────────────────────────────────────
    // Partition is selected automatically based on requested wall time:
    //   <= 4 h → htc    (public QOS, max 52 CPU / 185 GB per node)
    //   >  4 h → public (public QOS, max 28 CPU / 248 GB per node)
    // process_fast (0.5 h) + process_single (1 h) + process_medium (2 h) + process_high (3 h) → htc
    slurm {
        process.executor       = 'slurm'
        process.queue          = { task.time <= 24.h ? 'batch' : 'long' }
        process.clusterOptions = '--signal=USR2@180 --export=ALL,SLURM_SKIP_EPILOG=1'
        process.stageInMode    = 'symlink'
        process.scratch        = true
        process {
            // KEG_LASTZ can be thousands of short tasks — arrays amortise the
            // per-job scheduler overhead, so grouping partitions per task is
            // not needed unless benchmarks say otherwise.
            withName: '.*:LASTZ|.*:AXT_CHAIN|.*:REPEAT_FILLER|.*:KEG_LASTZ' {
                array = 500
            }
        }
        executor {
            queueSize         = 10000
            killBatchSize     = 1000000
            pollInterval      = '10 s'      // internal task-monitor tick (no SLURM RPC)
            queueStatInterval = '1 min'     // squeue cadence — halves RPC pressure
            submitRateLimit   = '100/1min'
            exitReadTimeout   = '5 min'    // tolerate slow .exitcode propagation; lets retry fire on ghosts
        }
    }

    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }

    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }

    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        conda.channels          = ['conda-forge', 'bioconda']
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }

    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }

    arm {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
        includeConfig 'conf/arm.config'
    }

    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }

    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }

    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }

    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }

    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.pullTimeout   = '60 min'
    }

    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }

    gitpod {
        executor.name           = 'local'
        executor.cpus           = 4
        executor.memory         = 8.GB
        process {
            resourceLimits = [
                memory: 8.GB,
                cpus  : 4,
                time  : 1.h
            ]
        }
    }

    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'

        process {
            withLabel: process_gpu {
                queue       = 'gpu'
                ext.use_gpu = true
            }
        }
    }

    // Local development on an AMD GPU through ZLUDA. Add AFTER gpu so it wins:
    //   bash assets/tests/ci/zluda_setup.sh
    //   nextflow run main.nf -profile docker,gpu,zluda --aligner kegalign ...
    //
    // KegAlign cannot run in its CUDA container here, so the three KegAlign
    // processes run natively against the tool directory zluda_setup.sh builds
    // (ZLUDA-wrapped kegalign, musl-wrapped faToTwoBit/lastz, KegAlign helper
    // scripts, bashlex). Everything else stays containerised as usual — the
    // process-level part of this lives in SECTION 7, which must come after
    // SECTION 5's blanket container selector.
    zluda {
        params.zluda = true

        // --gpus all needs the NVIDIA container runtime, which is absent here;
        // the native GPU tasks reach the card directly instead.
        docker.runOptions      = '-u $(id -u):$(id -g)'
        apptainer.runOptions   = ''
        singularity.runOptions = ''

        // A workstation, not a cluster: cap the cluster-sized requests.
        process.resourceLimits = [ cpus: params.zluda_cpus, memory: params.zluda_memory, time: 4.h ]
    }

    // Opt-in companion to `zluda`: puts the NVIDIA-only stubs from
    // `zluda_setup.sh WITH_MPS_STUBS=1` on the GPU task's PATH so
    // --kegalign_mps_workers > 1 can be exercised where NVIDIA MPS does not
    // exist. It makes the MPS preflight pass on a host with no MPS daemon, so it
    // validates the splitting/scheduling/keg/guard plumbing ONLY — never real MPS.
    zluda_mps_stub {
        params.zluda_mps_stub = true
    }

    test {
        params.reference_name   = 'test_ref'
        params.query_name       = 'test_query'
        params.reference_genome = "${projectDir}/assets/tests/test_data/test_reference.fa"
        params.query_genome     = "${projectDir}/assets/tests/test_data/test_query.fa"
        params.chain_linear_gap = 'loose'
        params.outdir           = 'test_results'
        params.use_container    = false

        params.skip_fill_chains = false
        params.skip_fill_unmask = false
        params.skip_clean_chain = false

        params.seq1_chunk    = 10000000
        params.seq2_chunk    = 10000000
        params.seq1_lap      = 0
        params.seq2_lap      = 10000 
        params.lastz_y       = 9400
        params.lastz_h       = 2000
        params.lastz_l       = 3000
        params.lastz_k       = 2400
        params.lastz_q       = null
        params.min_chain_score = 1000
        params.chain_linear_gap = 'loose'
        params.bundle_psl_max_bases = 1000000
        params.num_fill_jobs = 1000
        params.fill_insert_chain_min_score = 5000
        params.fill_gap_max_size_t = 20000
        params.fill_gap_max_size_q = 20000
        params.fill_gap_min_size_t = 30
        params.fill_gap_min_size_q = 30
        params.fill_lastz_k = 2000
        params.fill_lastz_l = 3000
        params.chain_clean_memory = 100
     }

    test_bgpu {
        params.aligner = 'kegalign'
        params.kegalign_executor = 'batched'

        params.reference_name   = 'test_ref'
        params.query_name       = 'test_query'
        params.reference_genome = "${projectDir}/assets/tests/test_data/test_reference.fa"
        params.query_genome     = "${projectDir}/assets/tests/test_data/test_query.fa"
        params.chain_linear_gap = 'loose'
        params.outdir           = 'test_results'
        params.use_container    = false

        params.skip_fill_chains = false
        params.skip_fill_unmask = false
        params.skip_clean_chain = false

        params.seq1_chunk    = 10000000
        params.seq2_chunk    = 10000000
        params.seq1_lap      = 0
        params.seq2_lap      = 10000 
        params.lastz_y       = 9400
        params.lastz_h       = 2000
        params.lastz_l       = 3000
        params.lastz_k       = 2400
        params.lastz_q       = null
        params.min_chain_score = 1000
        params.chain_linear_gap = 'loose'
        params.bundle_psl_max_bases = 1000000
        params.num_fill_jobs = 1000
        params.fill_insert_chain_min_score = 5000
        params.fill_gap_max_size_t = 20000
        params.fill_gap_max_size_q = 20000
        params.fill_gap_min_size_t = 30
        params.fill_gap_min_size_q = 30
        params.fill_lastz_k = 2000
        params.fill_lastz_l = 3000
        params.chain_clean_memory = 100
     }


    test_dgpu {
        params.aligner = 'kegalign'
        params.kegalign_executor = 'distributed'

        params.reference_name   = 'test_ref'
        params.query_name       = 'test_query'
        params.reference_genome = "${projectDir}/assets/tests/test_data/test_reference.fa"
        params.query_genome     = "${projectDir}/assets/tests/test_data/test_query.fa"
        params.chain_linear_gap = 'loose'
        params.outdir           = 'test_results'
        params.use_container    = false

        params.skip_fill_chains = false
        params.skip_fill_unmask = false
        params.skip_clean_chain = false

        params.seq1_chunk    = 10000000
        params.seq2_chunk    = 10000000
        params.seq1_lap      = 0
        params.seq2_lap      = 10000 
        params.lastz_y       = 9400
        params.lastz_h       = 2000
        params.lastz_l       = 3000
        params.lastz_k       = 2400
        params.lastz_q       = null
        params.min_chain_score = 1000
        params.chain_linear_gap = 'loose'
        params.bundle_psl_max_bases = 1000000
        params.num_fill_jobs = 1000
        params.fill_insert_chain_min_score = 5000
        params.fill_gap_max_size_t = 20000
        params.fill_gap_max_size_q = 20000
        params.fill_gap_min_size_t = 30
        params.fill_gap_min_size_q = 30
        params.fill_lastz_k = 2000
        params.fill_lastz_l = 3000
        params.chain_clean_memory = 100
     }

    test_hspz {
        params.aligner = 'hspz'

        params.reference_name   = 'test_ref'
        params.query_name       = 'test_query'
        params.reference_genome = "${projectDir}/assets/tests/test_data/test_reference.fa"
        params.query_genome     = "${projectDir}/assets/tests/test_data/test_query.fa"
        params.chain_linear_gap = 'loose'
        params.outdir           = 'test_results'
        params.use_container    = true

        params.skip_fill_chains = false
        params.skip_fill_unmask = false
        params.skip_clean_chain = false

        params.seq1_chunk    = 10000000
        params.seq2_chunk    = 10000000
        params.seq1_lap      = 0
        params.seq2_lap      = 10000 
        params.lastz_y       = 9400
        params.lastz_h       = 2000
        params.lastz_l       = 3000
        params.lastz_k       = 2400
        params.lastz_q       = null
        params.min_chain_score = 1000
        params.chain_linear_gap = 'loose'
        params.bundle_psl_max_bases = 1000000
        params.num_fill_jobs = 1000
        params.fill_insert_chain_min_score = 5000
        params.fill_gap_max_size_t = 20000
        params.fill_gap_max_size_q = 20000
        params.fill_gap_min_size_t = 30
        params.fill_gap_min_size_q = 30
        params.fill_lastz_k = 2000
        params.fill_lastz_l = 3000
        params.chain_clean_memory = 100
     }

    test_segments {
        params.reference_name   = 'test_ref'
        params.query_name       = 'test_query'
        params.reference_genome = "${projectDir}/assets/tests/test_data/test_reference.fa"
        params.query_genome     = "${projectDir}/assets/tests/test_data/test_query.fa"
        params.chain_linear_gap = 'loose'
        params.outdir           = 'test_results'
        params.segments_path    = "${projectDir}/assets/tests/test_data/segments"
        params.use_container    = true

        params.skip_fill_chains = false
        params.skip_fill_unmask = false
        params.skip_clean_chain = false

        params.seq1_chunk    = 10000000
        params.seq2_chunk    = 10000000
        params.seq1_lap      = 0
        params.seq2_lap      = 10000
        params.lastz_y       = 9400
        params.lastz_h       = 2000
        params.lastz_l       = 3000
        params.lastz_k       = 2400
        params.lastz_q       = null
        params.min_chain_score = 1000
        params.chain_linear_gap = 'loose'
        params.bundle_psl_max_bases = 1000000
        params.num_fill_jobs = 1000
        params.fill_insert_chain_min_score = 5000
        params.fill_gap_max_size_t = 20000
        params.fill_gap_max_size_q = 20000
        params.fill_gap_min_size_t = 30
        params.fill_gap_min_size_q = 30
        params.fill_lastz_k = 2000
        params.fill_lastz_l = 3000
        params.chain_clean_memory = 100
     }
}

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 4b — KegAlign backend resources  (--aligner kegalign)
//
// The process_gpu label only attaches the accelerator, so CPU/memory/time are
// set here. Declared conditionally so a default LASTZ run doesn't warn about
// unmatched process selectors.
// ══════════════════════════════════════════════════════════════════════════════

if (params.aligner == 'kegalign') {
  process {
    withName: '.*:REFERENCE_TO_FA|.*:QUERY_TO_FA' {
        cpus       = 1
        memory     = { 24.GB * task.attempt }
        time       = { 1.h   * task.attempt }
        publishDir = [ enabled: false ]
    }

    if (params.kegalign_mps_workers as int > 1) {
        // Same GPU allocation as KEGALIGN, more host memory: split_input.py
        // bin-packs each genome in min(cpus, 20) parallel processes that each
        // hold the whole FASTA in Python strings (~3.5 GB for hg38), and then N
        // KegAlign instances share these CPUs, as upstream intends.
        // ponytail: memory scales with cpus through split_input.py's process
        // pool — cap cpus before raising memory if a bigger genome pair OOMs.
        withName: '.*:KEGALIGN_MPS' {
            cpus       = 8
            memory     = { 80.GB * task.attempt }
            time       = { 8.h   * task.attempt }
            publishDir = [ enabled: false ]
        }
    }
    else {
        // KEGALIGN spends its CPUs on HSP output and diagonal partitioning while
        // holding the GPU — keep it modest, the GPU is the scarce resource.
        withName: '.*:KEGALIGN' {
            cpus       = 8
            memory     = { 60.GB * task.attempt }
            time       = { 4.h   * task.attempt }
            publishDir = [ enabled: false ]
        }
    }

    if (params.kegalign_executor == 'distributed') {
        withName: '.*:KEGALIGN_EXPAND' {
            label      = 'process_fast'
            publishDir = [ enabled: false ]
        }

        // One task per KegAlign partition: single-threaded LASTZ plus axtToPsl.
        // Resources escalate with task.attempt, so the global errorStrategy's
        // retry of a transient/OOM exit lands on a bigger allocation. That
        // strategy retries only recoverable exit statuses and aborts on the
        // rest, which is what we want — a deterministic format error must not
        // be retried.
        withName: '.*:KEG_LASTZ' {
            cpus       = 1
            memory     = { 8.GB * task.attempt }
            time       = { 1.h  * task.attempt }
            publishDir = [
                path: { "${params.outdir}/02_kegalign_psl" },
                mode: 'symlink',
                pattern: '*.psl'
            ]
        }
    }
    else if (params.kegalign_mps_workers as int > 1) {
        // One task per MPS keg, and a keg is now a single chromosome-bin pair —
        // a fraction of the whole-genome workload the sizing below assumes.
        // Deliberately small: the global errorStrategy retries a timeout or OOM
        // on a bigger allocation, whereas 16 CPUs x N bin pairs would only
        // queue. Re-tune from the benchmark's real per-keg usage.
        withName: '.*:KEGALIGN_LASTZ' {
            cpus       = 4
            memory     = { 24.GB * task.attempt }
            time       = { 4.h   * task.attempt }
            publishDir = [ enabled: false ]
        }

        withName: '.*:AXT_TO_PSL' {
            label      = 'process_medium'
            publishDir = [
                path: { "${params.outdir}/02_kegalign_psl" },
                mode: 'symlink',
                pattern: '*.psl'
            ]
        }
    }
    else {
        // The whole batched gapped-extension stage is one task — see the note
        // in modules/local/kegalign_lastz/main.nf.
        withName: '.*:KEGALIGN_LASTZ' {
            cpus       = 16
            memory     = { 50.GB * task.attempt }
            time       = { 12.h  * task.attempt }
            publishDir = [ enabled: false ]
        }

        withName: '.*:AXT_TO_PSL' {
            label      = 'process_medium'
            publishDir = [
                path: { "${params.outdir}/02_kegalign_psl" },
                mode: 'symlink',
                pattern: '*.psl'
            ]
        }
    }
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 5 — Container image
// Set the container image to use for all processes through use_container option.
// If not set, the default is to use the apptainer cache image for every module.
// To modify go to params.json and set 'use_container' to false.
// ══════════════════════════════════════════════════════════════════════════════

if (params.use_container) {
  process {
    withName: '.*' {
        container = System.getenv('NXF_CONTAINER_IMAGE') ?:
            'ghcr.io/hillerlab/make_lastz_chains:latest'
    }
    // Declared after the blanket selector so it wins: the monolithic image has
    // no KegAlign (CUDA), so these steps keep their own container. Version is
    // pinned in modules/local/kegalign{,_mps,_lastz}/main.nf — change it there too.
    // Under -profile zluda the CUDA image cannot run at all (AMD GPU via ZLUDA),
    // so the assignment is made here rather than fought with a second selector
    // in SECTION 5b: two selectors matching the same process do not reliably
    // override each other's container.
    withName: '.*:KEGALIGN|.*:KEGALIGN_MPS|.*:KEGALIGN_LASTZ' {
        container = params.zluda ? null : 'quay.io/biocontainers/kegalign-full:0.1.2.9--hdfd78af_0'
    }

    withName: '.*:HSPZ' {
      container = params.zluda ? 'ghcr.io/hillerlab/hspz:zluda' : 'ghcr.io/hillerlab/hspz:latest'
    }
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 5b — ZLUDA local development  (-profile docker,gpu,zluda)
//
// Sits outside profiles {} and keys off params.zluda because profile blocks are
// merged before SECTION 5, whose selectors would then win, and because
// `workflow` is not bound while this file is being parsed.
//
// Only beforeScript is decided here. `container` is decided by SECTION 5's own
// kegalign selector: where two withName selectors match the same process,
// which one wins the same directive is not dependable (measured — the CUDA image
// survived a later `container = null`), so the two never disagree.
//
// Run `bash assets/tests/ci/zluda_setup.sh` first — it builds ZLUDA_TOOLS.
// ══════════════════════════════════════════════════════════════════════════════

if (params.zluda) {
  // Shell-expanded in the task, not by Nextflow: ZLUDA_TOOLS may come from the
  // caller's environment.
  def zluda_tools = '${ZLUDA_TOOLS:-$HOME/.cache/make_lastz_chains/zluda}'
  def zluda_path  = "export PATH=\"${zluda_tools}/bin:\$PATH\"; " +
                    "export PYTHONPATH=\"${zluda_tools}/pylib\${PYTHONPATH:+:\$PYTHONPATH}\""
  // The NVIDIA-only stubs are prepended only with -profile zluda_mps_stub, and
  // only for KEGALIGN_MPS: they let the MPS plumbing run where MPS cannot.
  def zluda_mps_path = "export PATH=\"${zluda_tools}/mps-stub:${zluda_tools}/bin:\$PATH\"; " +
                       "export PYTHONPATH=\"${zluda_tools}/pylib:${zluda_tools}/pylib-mps\${PYTHONPATH:+:\$PYTHONPATH}\""

  // container = null runs the task natively, so it can reach the AMD GPU through
  // ZLUDA (it agrees with SECTION 5, and also covers use_container = false);
  // every other process stays containerised. KEGALIGN_MPS gets its own selector
  // rather than sharing one, because only it takes the stub PATH.
  process {
    withName: '.*:KEGALIGN|.*:KEGALIGN_LASTZ' {
        container    = null
        beforeScript = zluda_path
    }

    withName: '.*:KEGALIGN_MPS' {
        container    = null
        beforeScript = params.zluda_mps_stub ? zluda_mps_path : zluda_path
    }

    withName: '.*:HSPZ' {
        container = 'ghcr.io/hillerlab/hspz:zluda'
        // The image's ENTRYPOINT is hspZ itself, so it must be cleared; the
        // ZLUDA shim (libcuda.so.1) is mounted from the host and put on
        // LD_LIBRARY_PATH (ZLUDA_LIB is shell-expanded in the task).
        // ponytail: numeric gids — Docker 28's containerd image store resolves
        // --group-add NAMES against the image's /etc/group, and the image has
        // no render group; numeric ids bypass that. Gids are Fedora-specific
        // (video=39, render=105) — parametrise if other distros matter.
        containerOptions = '--entrypoint "" -v ${ZLUDA_LIB:-$HOME/opt/zluda}:/opt/zluda -e LD_LIBRARY_PATH=/opt/zluda --device=/dev/kfd --device=/dev/dri --group-add 39 --group-add 105'
    }
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 5c — hspZ backend resources  (--aligner hspz)
//
// The process_gpu label only attaches the accelerator, so CPU/memory/time are
// set here. Declared conditionally so a default LASTZ run doesn't warn about
// unmatched process selectors.
//
// MUST stay after SECTION 5's blanket `.*` selector: a withName rule's position
// in the merged map is its FIRST occurrence, and the last matching rule wins
// each directive — declared earlier, the blanket would override the hspz image
// (seen live: HSPZ ran in make_lastz_chains while 5b's containerOptions applied).
// ══════════════════════════════════════════════════════════════════════════════
if (params.aligner == 'hspz' || params.from == 'segments') {
  process {
    withName: '.*:HSPZ' {
        cpus       = 8
        memory     = { 60.GB * task.attempt }
        time       = { 18.h   * task.attempt }
        publishDir   = [
            path: { "${params.outdir}/02_hspz/segments" },
            mode: 'symlink'
        ]
    }

    withName: '.*:LASTZ_SEGMENTED' {
        label      = 'process_fast'
        publishDir   = [
            path: { "${params.outdir}/02_hspz/axt" },
            mode: 'symlink',
            pattern: '*.axt'
        ]
    }

    withName: '.*:AXT_TO_PSL' {
        label      = 'process_medium'
        publishDir = [
            path: { "${params.outdir}/02_hspz/psl" },
            mode: 'symlink',
            pattern: '*.psl'
        ]
    }
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 6 — Execution reporting
// ══════════════════════════════════════════════════════════════════════════════

def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
}

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 7 — Environment configuration
// ══════════════════════════════════════════════════════════════════════════════

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ENVIRONMENT CONFIG
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    REGISTRY CONFIG
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'
